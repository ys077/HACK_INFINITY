# PRODUCTION ENVIRONMENT VARIABLES
# Do not commit the actual .env.production file to source control.

PORT=5000
NODE_ENV=production

# Database
DATABASE_URL="postgresql://user:password@hostname:5432/presenza?schema=public&sslmode=require"

# Redis for Socket.IO Adapter
REDIS_URL="redis://:password@hostname:6379"

# Security Secrets
JWT_SECRET="generate-a-strong-cryptographic-secret"
SESSION_SECRET="generate-another-strong-secret"

# WebAuthn Configuration
WEBAUTHN_RP_ID="presenza.edu"
WEBAUTHN_RP_NAME="PRESENZA"
WEBAUTHN_ORIGIN="https://attendance.presenza.edu"

# Frontend Configuration
FRONTEND_URL="https://attendance.presenza.edu"

# Policy Settings
ALLOWED_EMAIL_DOMAIN="@presenza.edu"
